---
import league from '../data/league.json';
import { url } from '../lib/standings.js';
const title = Astro.props.title ?? Astro.props.frontmatter?.title;
const nav = [
  ['/', 'Home'],
  ['/draft', 'Draft Weekend'],
  ['/headlines', 'Headlines'],
  ['/standings', 'Standings'],
  ['/schedule', 'Schedule'],
  ['/awards', 'Awards'],
  ['/franchises', 'Franchises'],
  ['/news', 'News'],
  ['/history', 'History'],
  ['/shame', 'Shame'],
  ['/quotes', 'Quotes'],
  ['/rules', 'Rules'],
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href) => path === (url(href).replace(/\/$/, '') || '/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <title>{title ? `${title} | ${league.shortName}` : league.name}</title>
  </head>
  <body>
    <header>
      <a class="brand" href={url('/')}>❄ {league.shortName}</a>
      <nav>
        {nav.map(([href, label]) => (
          <a href={url(href)} class={isActive(href) ? 'active' : ''}>{label}</a>
        ))}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>{league.name} · {league.season} season</footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f4f7fb; --card: #fff; --text: #1a2233; --muted: #5b6475;
    --accent: #0b3d91; --border: #dde3ec; --win: #1a7f37;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #0f1520; --card: #172031; --text: #e6ebf3; --muted: #9aa6b8; --accent: #7fb0ff; --border: #2a3548; --win: #4ac26b; }
  }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; background: var(--bg); color: var(--text); line-height: 1.5; }
  header { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; padding: 1rem; border-bottom: 1px solid var(--border); background: var(--card); }
  .brand { font-weight: 800; font-size: 1.25rem; color: var(--accent); text-decoration: none; }
  nav { display: flex; flex-wrap: wrap; gap: 0.25rem; }
  nav a { color: var(--muted); text-decoration: none; padding: 0.35rem 0.6rem; border-radius: 6px; }
  nav a:hover, nav a.active { background: var(--bg); color: var(--accent); }
  main { max-width: 960px; margin: 0 auto; padding: 1.5rem 1rem 3rem; }
  footer { text-align: center; color: var(--muted); font-size: 0.875rem; padding: 2rem 1rem; }
  a { color: var(--accent); }
  .card { background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 1rem 1.25rem; margin-bottom: 1rem; }
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; background: var(--card); }
  th, td { padding: 0.5rem 0.75rem; border-bottom: 1px solid var(--border); text-align: left; white-space: nowrap; }
  th { color: var(--muted); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.03em; }
  .num { text-align: right; font-variant-numeric: tabular-nums; }
  .win { color: var(--win); font-weight: 700; }
  .muted { color: var(--muted); }
  .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
</style>
