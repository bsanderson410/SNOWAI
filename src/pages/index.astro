---
import Base from '../layouts/Base.astro';
import league from '../data/league.json';
import { getStandings, getNews, url } from '../lib/standings.js';
import { getHeadlines } from '../lib/headlines.js';
import { getQuoteOfTheWeek } from '../lib/quotes.js';
import { getWeeklyAwards } from '../lib/awards.js';
const top = getStandings().slice(0, 3);
const latest = getNews().slice(0, 3);
const stories = getHeadlines().slice(0, 3);
const quote = getQuoteOfTheWeek();
const latestAwards = getWeeklyAwards()[0];
---
<Base>
  <h1>{league.name}</h1>
  <p class="muted">{league.tagline}</p>

  {quote && (
    <section class="card qotw">
      <p class="label">💬 Quote of the Week</p>
      <p class="qtext">“{quote.text}”</p>
      <p class="muted">— {quote.by}</p>
      <a href={url('/quotes')}>Past quotes →</a>
    </section>
  )}

  {latestAwards && (
    <section class="card">
      <h2>🏅 Week {latestAwards.week} Awards</h2>
      <ul>
        {latestAwards.awards.map((a) => <li>{a.emoji} <strong>{a.title}:</strong> {a.team} <span class="muted">({a.detail})</span></li>)}
      </ul>
      <a href={url('/awards')}>All awards →</a>
    </section>
  )}

  <section class="card">
    <h2>📰 Headlines</h2>
    <ul>
      {stories.map((h) => <li><strong>{h.headline}</strong></li>)}
    </ul>
    <a href={url('/headlines')}>All headlines →</a>
  </section>

  <section class="card">
    <h2>Top of the table</h2>
    <ol>
      {top.map((t) => <li><strong>{t.name}</strong> ({t.wins}-{t.losses}{t.ties ? `-${t.ties}` : ''}) — {t.pointsFor.toFixed(1)} PF</li>)}
    </ol>
    <a href={url('/standings')}>Full standings →</a>
  </section>

  <section class="card">
    <h2>Latest news</h2>
    {latest.length === 0 && <p class="muted">No posts yet.</p>}
    <ul>
      {latest.map((p) => <li><a href={url(`/news/${p.slug}`)}>{p.title}</a> <span class="muted">· {p.date && new Date(p.date).toLocaleDateString('en-US', { timeZone: 'UTC' })}</span></li>)}
    </ul>
  </section>
</Base>

<style>
  .qotw .label { margin: 0; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); }
  .qotw .qtext { font-family: Georgia, 'Times New Roman', serif; font-size: 1.4rem; line-height: 1.3; margin: 0.4rem 0; }
  .qotw p { margin-top: 0; }
</style>
