---
import Base from '../layouts/Base.astro';
import { getHeadlines } from '../lib/headlines.js';
const items = getHeadlines();
---
<Base title="Headlines">
  <h1>The SNOWA Tribune</h1>
  <p class="muted">All the news that's fit to fabricate. Stories are 100% made up; the scores are real.</p>
  {items.map((h) => (
    <article class="card headline">
      <p class="kicker">{h.pinned ? 'Breaking' : `Week ${h.week}`}</p>
      <h2>{h.headline}</h2>
      {h.blurb && <p>{h.blurb}</p>}
    </article>
  ))}
</Base>

<style>
  .headline h2 { margin: 0.1rem 0 0.4rem; font-family: Georgia, 'Times New Roman', serif; font-size: 1.35rem; line-height: 1.25; }
  .headline p { margin: 0; }
  .kicker { color: #c0392b; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; }
</style>
